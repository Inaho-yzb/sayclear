{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "仅主窗口可读写工作区、配置并调用本地 AI 工具、通过原生选择器更换数据目录、导出文档、写入剪贴板及管理自身窗口。",
  "windows": ["main"],
  "permissions": [
    "allow-load-ai-settings",
    "allow-save-ai-settings",
    "allow-check-ai-tool",
    "allow-run-ai-turn",
    "allow-cancel-ai-turn",
    "allow-execute-graph-command",
    "allow-set-cli-ready",
    "allow-complete-cli-request",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "allow-load-workspace",
    "allow-save-workspace",
    "allow-inspect-git-repository",
    "allow-resolve-git-repository",
    "allow-choose-git-repository",
    "allow-create-git-iteration",
    "allow-load-history",
    "allow-validate-catalog",
    "allow-delete-system",
    "allow-get-data-directory",
    "allow-choose-data-directory",
    "allow-export-markdown",
    "allow-export-bundle",
    "allow-copy-text",
    "allow-app-platform"
  ]
}
