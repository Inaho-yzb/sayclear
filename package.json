{
  "name": "say-clear",
  "version": "0.1.0",
  "description": "通过自然对话，把想法整理成清晰的需求文档。",
  "private": true,
  "author": "Say Clear",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/native.mjs tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "tauri": "node scripts/native.mjs tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "cli": "node scripts/native.mjs cargo run --manifest-path src-tauri/Cargo.toml --bin sayclear --",
    "build:cli": "node scripts/native.mjs cargo build --manifest-path src-tauri/Cargo.toml --bin sayclear --release --locked",
    "test:cli": "node scripts/test-cli.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "build:web": "npm run typecheck && vite build",
    "build": "node scripts/native.mjs tauri build --no-bundle",
    "pack": "node scripts/native.mjs tauri build --bundles app",
    "dist": "node scripts/native.mjs tauri build",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:rust",
    "test:product-design": "node scripts/test-product-design.mjs",
    "test:iteration": "node scripts/test-iteration.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:iteration-management": "node scripts/test-iteration-management.mjs",
    "test:git": "node scripts/test-git.mjs",
    "test:export": "node scripts/test-export.mjs",
    "test:validation": "node scripts/test-validation.mjs",
    "preview:iteration": "node scripts/preview-iteration.mjs",
    "test:references": "node scripts/test-references.mjs",
    "test:composition": "node scripts/test-composition.mjs",
    "test:combined-diagram": "node scripts/test-combined-diagram.mjs",
    "test:combined-performance": "node scripts/test-combined-performance.mjs",
    "test:ai": "node scripts/test-ai.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@tauri-apps/cli": "^2.12.4",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
